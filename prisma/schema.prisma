// Prisma schema for Мета-Кристалл web app
// SQLite is used as prototype storage (production should use PostgreSQL + pgvector).
// Embeddings are stored as JSON arrays of floats; similarity search is done in-app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Flowmusic parameters indexed for embeddings-only RAG search.
/// Complex values are stored as JSON strings because the project uses SQLite.
model Parameter {
  id               String   @id @default(cuid())
  technicalName    String   @unique
  category         String   @default("uncategorized")
  subCategory      String   @default("uncategorized")
  uiElement        String
  minValue         Float?
  maxValue         Float?
  step             Float?
  defaultValue     Json
  unit             String?
  options          String?
  minLength        Int?
  maxLength        Int?
  semanticKeywords Json
  lyriaPromptTags  Json
  isVectorized     Boolean  @default(false)
  valueVectors     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([subCategory])
  @@index([isVectorized])
}

/// Crystals generated by the engine. Each row corresponds to a single
/// generated combination persisted to disk under meta_crystals/crystals/.
model Crystal {
  id            String   @id @default(cuid())
  code          String   @unique // 8-символьный код
  type          String // ИЗУМРУД | АЛМАЗ | ПРИНЦИП | ГИБРИД | КВАНТОВЫЙ ...
  category      String? // category path
  focus         String?
  pattern       String?
  /// Full combination text (formula)
  combination   String
  /// Compact text used for embedding (combination + focus + elements)
  searchText    String
  /// JSON-serialized list of elements
  elementsJson  String
  /// JSON-serialized list of operators
  operatorsJson String?
  /// Numeric metrics from MMSS: V, S, N, D_f, G_S, QEC, CHSH, C_val
  metricsJson   String?
  /// JSON reasons array (why this crystal got its classification)
  reasonsJson   String?
  qualityScore  Float?
  complexity    Int?
  counter       Int
  step          Int?
  /// Original filepath under meta_crystals/crystals/
  filepath      String
  /// Vector(384) stored as JSON array of floats (prototype substitute for pgvector)
  embedding     String?
  isFavourite   Boolean  @default(false)
  ghostCoordinate Json?
  ghostTrajectory Json?
  metadataJson  String?
  umapX         Float?
  umapY         Float?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([qualityScore])
  @@index([counter])
  @@index([isFavourite])
  @@index([createdAt])
}

/// Stored generation profiles (params + flags + metrics + custom patterns).
model Profile {
  id        String   @id @default(cuid())
  name      String   @unique
  paramsJson String
  flagsJson  String
  metricsJson String?
  customPatternsJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pipelines — ordered sequences of steps for batch generation.
model Pipeline {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// JSON array of PipelineStep objects
  stepsJson   String
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt

  runs        PipelineRun[]
}

model PipelineRun {
  id          String   @id @default(cuid())
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId  String
  status      String // pending | running | completed | failed | cancelled
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  resultJson  String?
  log         String?
  @@index([pipelineId])
  @@index([status])
}

/// Snapshots of the crystal library for rollback support.
model Snapshot {
  id        String   @id @default(cuid())
  label     String
  dataJson  String
  createdAt DateTime @default(now())
}

/// Enrichment runs log.
model EnrichmentLog {
  id          String   @id @default(cuid())
  paramsJson  String
  resultJson  String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

/// LLM chat messages persisted across sessions.
model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant | system
  content   String
  /// Was RAG context used for this message?
  ragContext String?
  provider  String?
  model     String?
  createdAt DateTime @default(now())
}

/// Key-value store for app settings (LLM provider, model, params, paths).
model Setting {
  key   String @id
  value String
}

/// Embeddings cache for lexicon terms, operators, patterns (used by RAG).
/// Each row is one searchable entity from the engine knowledge base.
model KnowledgeEntity {
  id        String   @id @default(cuid())
  kind      String // lexicon | operator | pattern | focus
  name      String
  category  String?
  /// JSON metadata (definition, type, properties)
  metaJson  String
  /// JSON array of floats (384-dim)
  embedding String?
  createdAt DateTime @default(now())

  @@unique([kind, name])
  @@index([kind])
}

/// Import batches for tracking imports.
model ImportBatch {
  id          String   @id @default(cuid())
  source      String
  /// JSON diff entries
  diffJson    String
  status      String // pending | applied | discarded
  createdAt DateTime @default(now())
}

/// Persisted Metis nodes imported from the main crystal library or created inside Metis Lab.
model MetisNode {
  id                  String   @id @default(cuid())
  nodeId              String   @unique
  crystalId           String
  sourceCrystalId     String?
  sourceCrystalCode   String?
  content             String
  importance          Float
  torusU              Float
  torusV              Float
  atlasChart          String
  svdRank             Int
  overflowFlag        Boolean  @default(false)
  embeddingPreviewJson String
  metadataJson        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceCrystalId])
  @@index([sourceCrystalCode])
  @@index([atlasChart])
  @@index([updatedAt])
}
