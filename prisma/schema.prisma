// Prisma schema for Мета-Кристалл web app
// SQLite is used as prototype storage (production should use PostgreSQL + pgvector).
// Embeddings are stored as JSON arrays of floats; similarity search is done in-app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Flowmusic parameters indexed for embeddings-only RAG search.
/// Complex values are stored as JSON strings because the project uses SQLite.
model Parameter {
  id               String   @id @default(cuid())
  technicalName    String   @unique
  category         String   @default("uncategorized")
  subCategory      String   @default("uncategorized")
  uiElement        String
  minValue         Float?
  maxValue         Float?
  step             Float?
  defaultValue     Json
  unit             String?
  options          String?
  minLength        Int?
  maxLength        Int?
  semanticKeywords Json
  lyriaPromptTags  Json
  isVectorized     Boolean  @default(false)
  valueVectors     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([subCategory])
  @@index([isVectorized])
}

/// Crystals generated by the engine. Each row corresponds to a single
/// generated combination persisted to disk under meta_crystals/crystals/.
model Crystal {
  id            String   @id @default(cuid())
  code          String   @unique // 8-символьный код
  type          String // ИЗУМРУД | АЛМАЗ | ПРИНЦИП | ГИБРИД | КВАНТОВЫЙ ...
  category      String? // category path
  focus         String?
  pattern       String?
  /// Full combination text (formula)
  combination   String
  /// Compact text used for embedding (combination + focus + elements)
  searchText    String
  /// JSON-serialized list of elements
  elementsJson  String
  /// JSON-serialized list of operators
  operatorsJson String?
  /// Numeric metrics from MMSS: V, S, N, D_f, G_S, QEC, CHSH, C_val
  metricsJson   String?
  /// JSON reasons array (why this crystal got its classification)
  reasonsJson   String?
  qualityScore  Float?
  complexity    Int?
  counter       Int
  step          Int?
  /// Original filepath under meta_crystals/crystals/
  filepath      String
  /// Vector(384) stored as JSON array of floats (prototype substitute for pgvector)
  embedding     String?
  isFavourite   Boolean  @default(false)
  ghostCoordinate Json?
  ghostTrajectory Json?
  metadataJson  String?
  umapX         Float?
  umapY         Float?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([qualityScore])
  @@index([counter])
  @@index([isFavourite])
  @@index([createdAt])
}

/// Stored generation profiles (params + flags + metrics + custom patterns).
model Profile {
  id        String   @id @default(cuid())
  name      String   @unique
  paramsJson String
  flagsJson  String
  metricsJson String?
  customPatternsJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pipelines — ordered sequences of steps for batch generation.
model Pipeline {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// JSON array of PipelineStep objects
  stepsJson   String
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt

  runs        PipelineRun[]
}

model PipelineRun {
  id          String   @id @default(cuid())
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId  String
  status      String // pending | running | completed | failed | cancelled
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  resultJson  String?
  log         String?
  @@index([pipelineId])
  @@index([status])
}

/// Snapshots of the crystal library for rollback support.
model Snapshot {
  id        String   @id @default(cuid())
  label     String
  dataJson  String
  createdAt DateTime @default(now())
}

/// Enrichment runs log.
model EnrichmentLog {
  id          String   @id @default(cuid())
  paramsJson  String
  resultJson  String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

/// LLM chat messages persisted across sessions.
model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant | system
  content   String
  /// Was RAG context used for this message?
  ragContext String?
  provider  String?
  model     String?
  createdAt DateTime @default(now())
}

/// Key-value store for app settings (LLM provider, model, params, paths).
model Setting {
  key   String @id
  value String
}

/// Embeddings cache for lexicon terms, operators, patterns (used by RAG).
/// Each row is one searchable entity from the engine knowledge base.
model KnowledgeEntity {
  id        String   @id @default(cuid())
  kind      String // lexicon | operator | pattern | focus
  name      String
  category  String?
  /// JSON metadata (definition, type, properties)
  metaJson  String
  /// JSON array of floats (384-dim)
  embedding String?
  createdAt DateTime @default(now())

  @@unique([kind, name])
  @@index([kind])
}

/// Import batches for tracking imports.
model ImportBatch {
  id          String   @id @default(cuid())
  source      String
  /// JSON diff entries
  diffJson    String
  status      String // pending | applied | discarded
  createdAt DateTime @default(now())
}

/// Durable user-authored or built-in AM-Stage automation definitions.
model AutomationScenario {
  id               String                    @id
  origin           String
  title            String
  description      String?
  currentVersionId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  archivedAt       DateTime?
  versions         AutomationScenarioVersion[]
  runs             AutomationRun[]

  @@index([origin, archivedAt])
  @@index([updatedAt])
}

/// Immutable definition version. Run plans pin a version rather than a mutable draft.
model AutomationScenarioVersion {
  id             String             @id
  scenarioId     String
  version        Int
  definitionJson String
  definitionHash String
  sourceVersion  Int?
  createdAt      DateTime           @default(now())
  scenario       AutomationScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  plans          AutomationPlan[]

  @@unique([scenarioId, version])
  @@index([definitionHash])
}

/// Immutable execution plan, captured before a run starts.
model AutomationPlan {
  id                String                      @id
  scenarioVersionId String?
  schemaVersion     Int
  documentJson      String
  fingerprint       String
  createdAt         DateTime                    @default(now())
  scenarioVersion  AutomationScenarioVersion? @relation(fields: [scenarioVersionId], references: [id], onDelete: Restrict)
  run               AutomationRun?

  @@index([fingerprint])
}

/// One persisted run; only one run may hold the application executor lock.
model AutomationRun {
  id                       String                    @id
  planId                   String                    @unique
  scenarioId               String?
  parentRunId              String?
  title                    String
  status                   String
  revision                 Int                       @default(0)
  createdAt                DateTime                  @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  updatedAt                DateTime                  @updatedAt
  currentStageId           String?
  stopRequestedAt          DateTime?
  stopReason               String?
  lastErrorSummary         String?
  resultAssessmentJson     String?
  resultAssessmentVersion  String?
  ownerInstanceId          String?
  plan                     AutomationPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  scenario                 AutomationScenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  stages                   AutomationStageExecution[]
  artifacts                AutomationArtifact[]
  events                   AutomationRunEvent[]
  parent                   AutomationRun?            @relation("AutomationRunParent", fields: [parentRunId], references: [id], onDelete: SetNull)
  children                 AutomationRun[]           @relation("AutomationRunParent")

  @@index([status, updatedAt])
  @@index([scenarioId, createdAt])
  @@index([parentRunId])
}

model AutomationStageExecution {
  id                  String                 @id
  runId               String
  stageId             String
  actionId            String
  orderIndex          Int
  documentJson        String
  status              String
  latestAttemptId     String?
  successfulAttemptId String?
  resolvedInputRefsJson String?
  outputArtifactRefsJson String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  run                 AutomationRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts            AutomationAttempt[]
  artifacts           AutomationArtifact[]

  @@unique([runId, stageId])
  @@index([runId, orderIndex])
}

model AutomationAttempt {
  id                   String                    @id
  stageExecutionId     String
  attemptNumber        Int
  status               String
  startedAt            DateTime                  @default(now())
  finishedAt           DateTime?
  effectiveConfigJson  String
  inputFingerprint     String
  outputArtifactRefsJson String?
  partialArtifactRefsJson String?
  errorJson            String?
  cancelReason         String?
  metricsJson          String?
  stage                AutomationStageExecution  @relation(fields: [stageExecutionId], references: [id], onDelete: Cascade)
  artifacts            AutomationArtifact[]

  @@unique([stageExecutionId, attemptNumber])
  @@index([status, startedAt])
}

/// Metadata stays in SQLite; payloads are stored as server-owned files.
model AutomationArtifact {
  id                String                    @id
  schemaVersion     Int
  kind              String
  runId             String
  stageExecutionId  String?
  attemptId         String?
  actionId          String
  bankId            String?
  modality          String?
  pass              String?
  modelBindingJson  String?
  effectiveSettingsJson String
  inputRefsJson     String
  sourceAssetRefsJson String
  audioRangeJson    String?
  segmentRefsJson   String
  createdAt         DateTime                  @default(now())
  validity          String
  warningsJson      String
  payloadRef        String
  checksum          String?
  run               AutomationRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage             AutomationStageExecution? @relation(fields: [stageExecutionId], references: [id], onDelete: SetNull)
  attempt           AutomationAttempt?         @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  references        AutomationArtifactReference[]

  @@index([runId, createdAt])
  @@index([stageExecutionId])
  @@index([attemptId])
  @@index([kind])
}

model AutomationAsset {
  id                 String                      @id
  kind               String
  contentHash        String                      @unique
  storageRef         String
  originalFilename   String?
  mimeType           String?
  sizeBytes          Int
  durationSeconds    Float?
  sampleRate         Int?
  channels           Int?
  createdAt          DateTime                    @default(now())
  availabilityStatus String                      @default("available")
  references         AutomationAssetReference[]

  @@index([createdAt])
  @@index([availabilityStatus])
}

model AutomationAssetReference {
  id        String          @id
  assetId   String
  ownerType String
  ownerId   String
  createdAt DateTime        @default(now())
  asset     AutomationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, ownerType, ownerId])
  @@index([ownerType, ownerId])
}

model AutomationArtifactReference {
  id         String             @id
  artifactId String
  ownerType  String
  ownerId    String
  createdAt  DateTime           @default(now())
  artifact   AutomationArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@unique([artifactId, ownerType, ownerId])
  @@index([ownerType, ownerId])
}

model AutomationCommand {
  id            String   @id
  commandId     String   @unique
  kind          String
  payloadHash   String
  runId         String?
  responseJson  String?
  createdAt     DateTime @default(now())

  @@index([runId, kind])
  @@index([createdAt])
}

model AutomationRunEvent {
  id          String        @id
  runId       String
  sequence    Int
  type        String
  stageId     String?
  attemptId   String?
  occurredAt  DateTime      @default(now())
  payloadJson String
  run         AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, occurredAt])
}

model AutomationExecutorLock {
  id              String   @id
  activeRunId     String?
  ownerInstanceId String?
  fencingToken    Int      @default(0)
  acquiredAt      DateTime?
  updatedAt       DateTime @updatedAt
}

/// Persisted Metis nodes imported from the main crystal library or created inside Metis Lab.
model MetisNode {
  id                  String   @id @default(cuid())
  nodeId              String   @unique
  crystalId           String
  sourceCrystalId     String?
  sourceCrystalCode   String?
  content             String
  importance          Float
  torusU              Float
  torusV              Float
  atlasChart          String
  svdRank             Int
  overflowFlag        Boolean  @default(false)
  embeddingPreviewJson String
  metadataJson        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceCrystalId])
  @@index([sourceCrystalCode])
  @@index([atlasChart])
  @@index([updatedAt])
}
