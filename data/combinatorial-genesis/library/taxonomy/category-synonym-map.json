      "lowercase",
      "replace / and - and & and whitespace runs with single underscore",
      "collapse multiple underscores",
      "strip leading/trailing underscores",
      "apply synonym_map (exact match on normalized form)",
      "if no map hit: keep normalized snake_case as category"
    ],
