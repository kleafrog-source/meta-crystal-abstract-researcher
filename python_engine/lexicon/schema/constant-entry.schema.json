{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meta-crystal.org/schemas/constant-entry.schema.json",
  "title": "Constant Entry",
  "description": "Schema for mathematical/scientific constants (e.g., φ, π, e, ħ)",
  "allOf": [
    {
      "$ref": "lexicon-entry.schema.json"
    },
    {
      "properties": {
        "entity_type": {
          "const": "constant"
        },
        "namespace": {
          "const": "constant"
        },
        "technical": {
          "properties": {
            "value_or_formula": {
              "type": ["string", "null"],
              "description": "Numeric value or formula for the constant"
            },
            "symbol": {
              "type": ["string", "null"],
              "description": "Mathematical symbol (e.g., φ, π, e)"
            },
            "domain": {
              "type": ["string", "null"],
              "description": "Scientific domain"
            }
          }
        }
      }
    }
  ]
}
