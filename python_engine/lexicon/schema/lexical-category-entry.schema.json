{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meta-crystal.org/schemas/lexical-category-entry.schema.json",
  "title": "Lexical Category Entry",
  "description": "Schema for lexical categories (groups of related terms)",
  "allOf": [
    {
      "$ref": "lexicon-entry.schema.json"
    },
    {
      "properties": {
        "entity_type": {
          "const": "lexical_category"
        },
        "namespace": {
          "const": "category"
        },
        "technical": {
          "properties": {
            "members": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Member terms in this category"
            },
            "category_type": {
              "type": ["string", "null"],
              "description": "Type of category (e.g., domain, pattern_group, operator_group)"
            }
          }
        }
      }
    }
  ]
}
